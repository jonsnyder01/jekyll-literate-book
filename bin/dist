#!/usr/bin/env ruby
# frozen_string_literal: true

# Assembles dist/, the jekyll-literate gem as published: the book tangled
# naked (`entangled tangle -a naked`, without the annotations the source
# browser needs) into gem/, plus gem-static/, the fonts, licences and prose
# that are not tangled, which keep their modes. Entangled writes files
# readable only by their owner and never executable, so each tangled file gets
# the mode git should record for it: executable when it starts with a
# shebang. `literate build` tangles gem/ again with annotations.

require "fileutils"
require "json"

Dir.chdir(File.expand_path("..", __dir__))
system("entangled", "tangle", "--annotate", "naked") or abort "dist: `entangled tangle` failed"
targets = JSON.parse(File.read(".entangled/filedb.json")).fetch("targets")
outside = targets.reject { |path| path.start_with?("gem/") }
abort "dist: tangled outside gem/: #{outside.join(", ")}" unless outside.empty?

tangled = targets.map { |path| path.delete_prefix("gem/") }
static = Dir.glob("**/*", File::FNM_DOTMATCH, base: "gem-static").select { |p| File.file?("gem-static/#{p}") }
clash = static & tangled
abort "dist: both tangled and in gem-static/: #{clash.join(", ")}" unless clash.empty?

FileUtils.rm_rf("dist")
copy = lambda do |from, path|
  FileUtils.mkdir_p(File.dirname("dist/#{path}"))
  FileUtils.cp(from, "dist/#{path}", preserve: true)
end
tangled.each do |path|
  copy.("gem/#{path}", path)
  File.chmod(File.binread("dist/#{path}", 2) == "#!" ? 0o755 : 0o644, "dist/#{path}")
end
static.each { |path| copy.("gem-static/#{path}", path) }

puts "dist: #{tangled.size} tangled and #{static.size} static files"
